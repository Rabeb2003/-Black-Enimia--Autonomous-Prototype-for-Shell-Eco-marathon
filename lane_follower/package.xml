<?xml version="1.0"?>
<package format="3">
  <name>lane_follower</name>
  <version>0.0.1</version>
  <description>Lane detection, path planning, and pure-pursuit control nodes for a small autonomous vehicle.</description>

  <maintainer email="ihw@example.com">ihw</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
