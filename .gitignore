# Ignore everything except specific directories
*

# But keep these directories
!src/
!src/enimia_black_description/
!src/enimia_black_description/**
!src/enimia_rl/
!src/enimia_rl/enimia_rl/
!src/enimia_rl/enimia_rl/**
!README.md
!.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo

# Large model files
src/enimia_black_description/models/
*.pt
*.torchscript
*.onnx

# Large mesh files
src/enimia_black_description/meshes/
*.stl
*.dae

# Images
*.png
*.jpg
*.jpeg
*.gif

# World files
src/enimia_black_description/world/
*.sdf
*.world
