# ===== ENIMIA BLACK - Git Ignore =====

# Build / install / log artifacts
build/
install/
log/

# Python cache
__pycache__/
*.pyc
*.pyo

# Large model files (tracked via Git LFS or manually)
*.pt
*.torchscript
*.onnx

# Large mesh files
src/enimia_black_description/meshes/
*.stl
*.dae

# Images / captures
*.png
*.jpg
*.jpeg
*.gif

# Videos
*.mp4
*.avi
*.mkv

# World files are large but we want new_circuit.world tracked
src/enimia_black_description/world/*.sdf

# RL training data (917MB of obs_*.json)
src/enimia_rl/data/

# RL trained model weights (large zip)
models/
*.zip

# Docs / PDF / Maps
src/enimia_black_description/docs/
*.pdf
*.kml
*.kmz

# ROS bags
*.bag
*.db3

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
