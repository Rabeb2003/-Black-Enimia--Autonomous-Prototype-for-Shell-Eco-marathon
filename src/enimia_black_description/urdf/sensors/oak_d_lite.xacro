<?xml version="1.0"?>
<robot name="oak_d_lite_sensor" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== OAK-D Lite Depth Camera ===================== -->
  <xacro:macro name="oak_d_lite" params="parent:='base_link' name:='oak' xyz:='0 0 0' rpy:='0 0 0'">
    
    <!-- Link du capteur avec mesh personnalisé -->
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
        <geometry>
          <!-- Mesh STL du boîtier OAK-D Lite - enclosure complète -->
          <mesh filename="package://enimia_black_description/meshes/sensors/oak_enclosure.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="oak_black">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
        <geometry>
          <!-- Mesh STL pour collision -->
          <mesh filename="package://enimia_black_description/meshes/sensors/oak_enclosure.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.050"/>  <!-- ~50g -->
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- Joint fixe avec le parent -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Frames caméra compatibles avec les conventions depthai_ros. -->
    <link name="${name}_frame"/>
    <joint name="${name}_center_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_model_origin"/>
    <joint name="${name}_model_origin_joint" type="fixed">
      <parent link="${name}_frame"/>
      <child link="${name}_model_origin"/>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
    </joint>

    <link name="${name}_imu_frame"/>
    <joint name="${name}_imu_joint" type="fixed">
      <parent link="${name}_frame"/>
      <child link="${name}_imu_frame"/>
      <origin xyz="0 -0.015 -0.013662" rpy="0 1.57079632679 0"/>
    </joint>

    <link name="${name}_rgb_camera_frame"/>
    <joint name="${name}_rgb_camera_joint" type="fixed">
      <parent link="${name}_frame"/>
      <child link="${name}_rgb_camera_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_rgb_camera_optical_frame"/>
    <joint name="${name}_rgb_camera_optical_joint" type="fixed">
      <parent link="${name}_rgb_camera_frame"/>
      <child link="${name}_rgb_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <link name="${name}_left_camera_frame"/>
    <joint name="${name}_left_camera_joint" type="fixed">
      <parent link="${name}_frame"/>
      <child link="${name}_left_camera_frame"/>
      <origin xyz="0 0.0375 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_left_camera_optical_frame"/>
    <joint name="${name}_left_camera_optical_joint" type="fixed">
      <parent link="${name}_left_camera_frame"/>
      <child link="${name}_left_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <link name="${name}_right_camera_frame"/>
    <joint name="${name}_right_camera_joint" type="fixed">
      <parent link="${name}_frame"/>
      <child link="${name}_right_camera_frame"/>
      <origin xyz="0 -0.0375 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_right_camera_optical_frame"/>
    <joint name="${name}_right_camera_optical_joint" type="fixed">
      <parent link="${name}_right_camera_frame"/>
      <child link="${name}_right_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <link name="${name}_depth_camera_frame"/>
    <joint name="${name}_depth_camera_joint" type="fixed">
      <parent link="${name}_frame"/>
      <child link="${name}_depth_camera_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_depth_camera_optical_frame"/>
    <joint name="${name}_depth_camera_optical_joint" type="fixed">
      <parent link="${name}_depth_camera_frame"/>
      <child link="${name}_depth_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <!-- ===================== Gazebo Plugin RGB Camera ===================== -->
    <gazebo reference="${name}_rgb_camera_frame">
      <material>Gazebo/DarkGrey</material>
      
      <sensor type="camera" name="${name}_rgb_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <camera name="${name}_rgb">
          <horizontal_fov>1.047</horizontal_fov>  <!-- 60° -->
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <plugin name="${name}_rgb_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${name}</namespace>
          </ros>
          <camera_name>rgb</camera_name>
          <frame_name>${name}_rgb_camera_optical_frame</frame_name>
          <hack_baseline>0.075</hack_baseline>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ===================== Gazebo Plugin Left Camera ===================== -->
    <gazebo reference="${name}_left_camera_frame">
      <sensor type="camera" name="${name}_left_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <camera name="${name}_left">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
        <plugin name="${name}_left_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${name}</namespace>
          </ros>
          <camera_name>left</camera_name>
          <frame_name>${name}_left_camera_optical_frame</frame_name>
          <hack_baseline>0.075</hack_baseline>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ===================== Gazebo Plugin Right Camera ===================== -->
    <gazebo reference="${name}_right_camera_frame">
      <sensor type="camera" name="${name}_right_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <camera name="${name}_right">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
        <plugin name="${name}_right_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${name}</namespace>
          </ros>
          <camera_name>right</camera_name>
          <frame_name>${name}_right_camera_optical_frame</frame_name>
          <hack_baseline>0.075</hack_baseline>
        </plugin>
      </sensor>
    </gazebo>

    <!-- ===================== Gazebo Plugin Depth Camera ===================== -->
    <gazebo reference="${name}_depth_camera_frame">
      <sensor type="depth" name="${name}_depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera name="${name}_depth">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <depth_camera/>
          <clip>
            <near>0.1</near>
            <far>50.0</far>
          </clip>
        </camera>
        <plugin name="${name}_depth_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${name}</namespace>
            <remapping>depth/image_raw:=depth/rgb/image_raw</remapping>
            <remapping>depth/camera_info:=depth/rgb/camera_info</remapping>
            <remapping>depth/depth/image_raw:=depth/image_raw</remapping>
            <remapping>depth/depth/camera_info:=depth/camera_info</remapping>
            <remapping>depth/points:=depth/points</remapping>
          </ros>
          <camera_name>depth</camera_name>
          <frame_name>${name}_depth_camera_optical_frame</frame_name>
          <min_depth>0.1</min_depth>
          <max_depth>50.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
