<?xml version="1.0"?>
<robot name="livox_mid360_sensor" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Livox Mid-360 LiDAR ===================== -->
  <!-- Paramètres du capteur -->
  <xacro:macro name="livox_mid360" params="parent:='base_link' name:='livox' xyz:='0 0 0' rpy:='0 0 0'">
    
    <!-- Link du capteur -->
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
        <geometry>
          <!-- Mesh STL réel du Livox Mid-360 -->
          <mesh filename="package://enimia_black_description/meshes/sensors/livox_mid360.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="livox_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
        <geometry>
          <mesh filename="package://enimia_black_description/meshes/sensors/livox_mid360.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.265"/>  <!-- Masse réelle du Mid-360 -->
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Joint du capteur avec le parent -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Frame optique -->
    <link name="${name}_optical_frame"/>
    
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_optical_frame"/>
      <origin xyz="0 0 0.0325" rpy="0 0 0"/>  <!-- Centre optique Livox aligned (X avant, Y gauche, Z haut) -->
    </joint>

    <!-- ===================== Gazebo Plugin pour Simulation ===================== -->
    <gazebo reference="${name}_link">
      <!-- Matériel visuel -->
      <material>Gazebo/Black</material>
      
      <!-- Plugin LiDAR Ray pour Gazebo avec Point Cloud -->
      <sensor type="ray" name="${name}_laser">
        <pose>0 0 0.0325 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>  <!-- -180° -->
              <max_angle>3.14159</max_angle>    <!-- +180° -->
            </horizontal>
            <vertical>
              <samples>8</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>  <!-- -15° -->
              <max_angle>0.261799</max_angle>    <!-- +15° -->
            </vertical>
          </scan>
          <range>
            <min>0.5</min>
            <max>50.0</max>
            <resolution>0.05</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="${name}_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=${name}/points</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>${name}_optical_frame</frame_name>
        </plugin>
      </sensor>

      <!-- Scan 2D léger pour SLAM Toolbox. Le point cloud 3D reste publié sur /livox/points. -->
      <sensor type="ray" name="${name}_mapping_scan">
        <pose>0 0 0.0325 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.5</min>
            <max>50.0</max>
            <resolution>0.05</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="${name}_scan_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <!-- Keep the 2D navigation scan next to the Livox point cloud.
                 AMCL/Nav2 consume this topic as /livox/scan. -->
            <remapping>~/out:=${name}/scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${name}_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
