    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.21" length="0.035"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0179333" ixy="0" ixz="0" iyy="0.0356625" iyz="0" izz="0.0179333"/>
    </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
