    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="40"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

