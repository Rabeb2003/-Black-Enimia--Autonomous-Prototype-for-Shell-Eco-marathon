<?xml version="1.0"?>
<!--
  ENIMIA - Black Edition (ENIM Team Tunisia) - Prototype Shell Eco-marathon      v3 (surface lissee)
  Carrosserie reconstruite a partir des silhouettes des vues de dessus et de cote :
    - profil de toit / bas de caisse releve pixel par pixel sur la vue de cote
    - largeur (plan) relevee sur la vue de dessus
    - 2 carenes de roues avant (contour releve sur la vue de cote + vue de dessus)
    - vitrage (cockpit + vitres laterales) et bord de fuite rouge separes
  v3 : profils C2 (B-splines), raccords carenes/fuselage arrondis, lissage de Taubin,
       maillages COLLADA (.dae) avec normales par sommet -> ombrage lisse dans RViz/Gazebo.
       Copies STL (ombrage plat) dans meshes/stl/ pour les outils qui ne lisent pas le DAE.
  Dimensions : L 2684 x l 770 x h 695 mm, empattement 1704 mm,
               voie avant 567 mm, masse 25 kg
  Porte-a-faux : avant 593 mm, arriere 387 mm
  Roues : avant R 210 mm (limite par la carene), arriere R 180 mm (arc du pneu)

  EDITION ANNIVERSAIRE : un gateau d'anniversaire est pose sur le plancher de l'habitacle
  (lien birthday_cake_link, fixe a base_link). Masse du gateau 2.53 kg -> masse totale 27.53 kg.

  Arbre cinematique :
    base_footprint (sol, milieu de l'empattement)
      └─ base_link (chassis, a hauteur d'axe avant)
           ├─ body_link               (coque + vitrage + bord de fuite, fixe : contient tout)
           ├─ front_left_steer_link   (revolute)   └─ front_left_wheel_link  (continuous)
           ├─ front_right_steer_link  (revolute)   └─ front_right_wheel_link (continuous)
           └─ rear_wheel_link         (continuous, motrice)
  Reperes REP-103 : X avant, Y gauche, Z haut. Unites SI.
-->
<robot name="enimia_black_birthday">

  <!-- ===================== Materiaux ===================== -->
  <material name="carbon_black"><color rgba="0.07 0.07 0.08 0.55"/></material>
  <material name="glass"><color rgba="0.20 0.32 0.40 0.35"/></material>
  <material name="tail_red"><color rgba="0.80 0.08 0.08 0.9"/></material>
  <material name="aluminium"><color rgba="0.75 0.76 0.78 1.0"/></material>
  <material name="tire"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="rim"><color rgba="0.82 0.82 0.84 1.0"/></material>
  <material name="floor"><color rgba="0.35 0.30 0.70 1.0"/></material>
  <material name="battery"><color rgba="0.85 0.80 0.15 1.0"/></material>
  <!-- gateau -->
  <material name="cake_plate"><color rgba="0.93 0.93 0.96 1"/></material>
  <material name="chocolate"><color rgba="0.36 0.19 0.1 1"/></material>
  <material name="ganache"><color rgba="0.22 0.1 0.05 1"/></material>
  <material name="vanilla"><color rgba="0.98 0.93 0.8 1"/></material>
  <material name="cream"><color rgba="1.0 0.98 0.94 1"/></material>
  <material name="pink_icing"><color rgba="0.96 0.55 0.7 1"/></material>
  <material name="pink_light"><color rgba="1.0 0.78 0.86 1"/></material>
  <material name="strawberry"><color rgba="0.85 0.08 0.12 1"/></material>
  <material name="leaf"><color rgba="0.2 0.6 0.2 1"/></material>
  <material name="candle_red"><color rgba="0.88 0.1 0.12 1"/></material>
  <material name="candle_white"><color rgba="0.97 0.97 0.97 1"/></material>
  <material name="wick"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="flame_core"><color rgba="1.0 0.95 0.55 1"/></material>
  <material name="flame_outer"><color rgba="1.0 0.55 0.05 0.75"/></material>
  <material name="gold"><color rgba="0.95 0.72 0.15 1"/></material>
  <material name="plaque"><color rgba="0.99 0.98 0.95 1"/></material>
  <material name="sprinkle_red"><color rgba="0.95 0.2 0.25 1"/></material>
  <material name="sprinkle_yellow"><color rgba="1.0 0.85 0.15 1"/></material>
