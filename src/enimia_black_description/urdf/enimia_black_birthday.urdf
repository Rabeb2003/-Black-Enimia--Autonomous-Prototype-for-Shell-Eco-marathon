      <origin xyz="-0.05 0 -0.050" rpy="0 0 0"/>
      <mass value="12.7"/>
      <inertia ixx="0.137583" ixy="0" ixz="0" iyy="2.42358" iyz="0" izz="2.4765"/>
    </inertial>
  </link>

  <!-- ===================== Coque (corps) ===================== -->
  <!-- Maillages exprimes dans le repere sol (origine au milieu de l'empattement) -->
  <link name="body_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://enimia_black_description/meshes/body_shell.dae"/></geometry>
      <material name="carbon_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://enimia_black_description/meshes/canopy.dae"/></geometry>
      <material name="glass"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://enimia_black_description/meshes/tail_tip.dae"/></geometry>
      <material name="tail_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://enimia_black_description/meshes/body_collision.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.1939 0 0.329146" rpy="0 0 0"/>
      <mass value="7.0"/>
      <inertia ixx="0.587735" ixy="0.00022506" ixz="0.084203" iyy="3.65022" iyz="0" izz="3.67245"/>
    </inertial>
  </link>

  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Roue avant gauche (dans sa carene) ===================== -->
  <link name="front_left_steer_link">
    <visual>
      <origin xyz="0 -0.040 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.04 0.10"/></geometry>
      <material name="aluminium"/>
    </visual>
    <inertial>
      <origin xyz="0 -0.040 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.000386667" ixy="0" ixz="0" iyy="0.000453333" iyz="0" izz="0.000173333"/>
    </inertial>
  </link>

  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <origin xyz="0.8520 0.2835 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="150" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.21" length="0.035"/></geometry>
      <material name="tire"/>
