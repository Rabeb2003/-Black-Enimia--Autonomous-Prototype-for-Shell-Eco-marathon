  <material name="sprinkle_orange"><color rgba="1.0 0.55 0.15 1"/></material>

  <!-- ===================== Base ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.21" rpy="0 0 0"/>
  </joint>

  <!-- Chassis : plancher, traverse avant, colonne de direction, arceau, bras arriere, batterie -->
  <link name="base_link">
